# служебный кэш Python (появляется при запуске tools/*.py)
__pycache__/
*.pyc

# локальный кэш медиа для тестов Playwright (видео сцен в webm)
от-второго-клауда/тесты/cache/
от-второго-клауда/тесты/botw.mjs
от-второго-клауда/тесты/shots-pf/
# скрины, которые пишут тесты при каждом прогоне
от-второго-клауда/тесты/*.png
от-второго-клауда/тесты/shots/

# КЛЮЧИ Cloudflare — в репо не должно быть НИКОГДА (глобальный ключ = доступ ко всему аккаунту)
.cf-token
.r2-key
**/.cf-token
**/.r2-key
