{
  "name": "restless-overlay",
  "productName": "Restless Overlay",
  "version": "0.2.0",
  "description": "Restless — панель матча поверх Deadlock",
  "main": "main.js",
  "author": "Restless",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "app.restless.overlay",
    "productName": "Restless Overlay",
    "files": [
      "main.js",
      "bridge.js",
      "install.js",
      "pak42_dir.vpk",
      "setup.html",
      "icon.png"
    ],
    "win": {
      "target": "portable",
      "icon": "icon.png"
    },
    "portable": {
      "artifactName": "Restless-Overlay.exe"
    }
  }
}
